[Unit]
Description=Scanner alerter
Requires=scanner-valkey.service
After=scanner-valkey.service network-online.target

[Service]
Type=simple
User=scanner
Group=scanner
WorkingDirectory=/opt/scanner/app
EnvironmentFile=/opt/scanner/.env.production
ExecStart=/opt/scanner/app/.venv/bin/python -u -m scanner.alerter
Restart=always
RestartSec=5s
StartLimitBurst=10
StartLimitIntervalSec=60
# SE-approved deviation from BUILD_GUIDE §18: log to a file instead of journald
# so the released CloudWatch agent's "files" collector can ship these logs.
StandardOutput=append:/opt/scanner/logs/alerter.log
StandardError=append:/opt/scanner/logs/alerter.log

[Install]
WantedBy=multi-user.target
