[Unit]
Description=Scanner feature-worker
Requires=scanner-valkey.service
After=scanner-valkey.service network-online.target

[Service]
Type=simple
User=scanner
Group=scanner
WorkingDirectory=/opt/scanner/app
EnvironmentFile=/opt/scanner/.env.production
ExecStart=/opt/scanner/app/.venv/bin/python -u -m scanner.bar_builder
Restart=always
RestartSec=5s
StartLimitBurst=10
StartLimitIntervalSec=60
StandardOutput=append:/opt/scanner/logs/feature-worker.log
StandardError=append:/opt/scanner/logs/feature-worker.log

[Install]
WantedBy=multi-user.target
