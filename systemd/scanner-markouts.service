[Unit]
Description=Scanner markouts
Requires=scanner-valkey.service
After=scanner-valkey.service network-online.target

[Service]
Type=simple
User=scanner
Group=scanner
WorkingDirectory=/opt/scanner/app
EnvironmentFile=/opt/scanner/.env.production
ExecStart=/opt/scanner/app/.venv/bin/python -u -m scanner.markouts
Restart=always
RestartSec=5s
StartLimitBurst=10
StartLimitIntervalSec=60
StandardOutput=append:/opt/scanner/logs/markouts.log
StandardError=append:/opt/scanner/logs/markouts.log

[Install]
WantedBy=multi-user.target
