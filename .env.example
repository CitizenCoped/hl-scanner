# Application
ENV=development
LOG_LEVEL=INFO

# Database
POSTGRES_URL=postgresql://user:pass@localhost:5432/hl_scanner?sslmode=disable

# Cache
VALKEY_URL=redis://localhost:6379/0

# Storage
S3_BUCKET=your-bucket
DASHBOARD_BUCKET=your-dashboard-bucket
AWS_REGION=ap-northeast-1

# Universe selection (BUILD_GUIDE §4)
HL_MIN_24H_NOTIONAL=10000000
HL_MAX_COINS=180
HL_UNIVERSE_REFRESH_SEC=21600
# HL_COINS is an optional comma-separated pin/allowlist always included.
HL_COINS=

# Notifications (optional)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
DISCORD_WEBHOOK_URL=
# SNS topic for ops status/alerts (e.g. nightly compaction success/fail email).
ALERT_SNS_TOPIC_ARN=
